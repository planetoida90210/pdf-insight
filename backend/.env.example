# Copy to .env for local runs. Never commit real keys.
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
LLM_TIMEOUT_SECONDS=60

# Comma-separated; production uses only the GitHub Pages origin.
ALLOWED_ORIGINS=https://planetoida90210.github.io,http://localhost:5173

MAX_FILE_MB=10
MAX_PAGES=200
OCR_LANG=pol+eng
OCR_MIN_CHARS=25
OCR_MIN_CONFIDENCE=60
VISION_FALLBACK=true
# More visible text than this is refused (TEXT_TOO_LONG); bounds memory, the cache and LLM cost.
MAX_TEXT_CHARS=2000000
CHUNK_CHARS=150000

RATE_LIMIT_PER_MINUTE=20
# Every LLM call counts: analysis, its retry and vision OCR of a page.
DAILY_LLM_CALL_LIMIT=1000
EXTRACTION_TTL_SECONDS=900
EXTRACT_TIMEOUT_SECONDS=85
# Address-space cap of the process that parses one upload (Linux).
EXTRACT_MEMORY_MB=320
ANALYZE_TIMEOUT_SECONDS=85
